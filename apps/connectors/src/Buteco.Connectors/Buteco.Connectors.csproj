<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    O Google continua sem biblioteca (design.md da apps-connectors-google-drive, D2): é chamado
    por REST com HttpClient, e o JWT da service account é assinado com
    System.Security.Cryptography. O único PackageReference de produção é o JwtBearer,
    que valida o token do emissor do apps/api (validacao-jwks-inbox-connectors, D1).
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Buteco.Connectors.Tests" />
  </ItemGroup>

</Project>
