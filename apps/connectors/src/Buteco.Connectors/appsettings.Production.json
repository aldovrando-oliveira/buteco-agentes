{
  // Nível de log de produção, versionado, no molde de apps/api e apps/inbox
  // (change compactacao-historico, D5). Este app não tem banco, então não há
  // Database.Command a silenciar; o que fica em Warning é o log por requisição do
  // HttpClient, que gravaria uma linha por chamada ao Google com a URL inteira.
  "Logging": {
    "LogLevel": {
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
