# Copie este arquivo para .env e ajuste se necessário. Nunca versionar o .env
# real (já coberto por .gitignore). O Vite lê variáveis de ambiente a partir
# da raiz deste projeto (apps/frontend) — o .env.example da raiz do monorepo
# não se aplica aqui.

# URL base da apps/api (perfil "http" do launchSettings.json em dev).
VITE_API_BASE_URL=http://localhost:5017

# URL base da apps/inbox (perfil "http" do launchSettings.json em dev).
VITE_INBOX_BASE_URL=http://localhost:5027

# URL base do apps/connectors (perfil "http" do launchSettings.json em dev).
# OPCIONAL, ao contrário das duas acima: sem ela, a origem "Sincronizada" do
# cadastro de base aparece indisponível e o painel não chama o apps/connectors.
# Vazio ("") significa caminho relativo, como nas outras duas.
VITE_CONNECTORS_BASE_URL=http://localhost:5037
