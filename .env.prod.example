# Copie para .env.prod na VM de servidor (fora do controle de versão,
# mesmo princípio do .env de dev — ver .gitignore). Consumido por
# docker-compose.prod.yml via interpolação ${VAR} nos blocos
# environment: dos serviços — nunca como env_file compartilhado (ver
# docs/deployment.md e
# openspec/changes/archive/2026-08-26-containerizacao-stack-servidor/design.md, D7).
#
# Segredos marcados "byte-idêntico entre processos" precisam do MESMO
# valor — a interpolação do compose já garante isso (uma variável, usada
# nos dois lugares); não copie o valor manualmente para chaves separadas.

# ---------------------------------------------------------------------------
# Postgres do stack de servidor (D10) — imagem própria, sem porta
# publicada no host.
# ---------------------------------------------------------------------------
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme-gerar-senha-forte

# ---------------------------------------------------------------------------
# RabbitMQ do stack de servidor (D10) — imagem própria, sem porta
# publicada no host.
# ---------------------------------------------------------------------------
RABBITMQ_USER=changeme
RABBITMQ_PASSWORD=changeme-gerar-senha-forte

# ---------------------------------------------------------------------------
# Domínio público pelo qual o stack é alcançado de fora (via o nginx
# externo/Cloudflare já existentes, fora desta change). Usado por
# PublicUrl__BaseUrl de apps/api (AgentCard.SupportedInterfaces) e de
# apps/inbox (D8 — mesmo domínio, ver Risks no design.md).
# ---------------------------------------------------------------------------
PUBLIC_DOMAIN=https://changeme.exemplo.com

# ---------------------------------------------------------------------------
# Fuso horário de apps/workers — nome IANA canônico, sem prefixo ":".
# Sem default seguro possível (ver 01-ARQUITETURA_E_CONVENCOES.md).
# ---------------------------------------------------------------------------
TZ=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Provedor de LLM usado por apps/workers (seção "OpenAI" — endpoint no
# formato OpenAI: OpenAI, Azure OpenAI ou gateway compatível). apps/api só
# checa presença da chave para listar em GET /providers.
# ---------------------------------------------------------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=changeme
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Byte-idêntica entre apps/api e apps/workers. Gerar com:
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
MCP_CREDENTIAL_ENCRYPTION_KEY=changeme-run-openssl-rand--base64-32

# ---------------------------------------------------------------------------
# Só apps/inbox — própria, nunca a mesma de MCP_CREDENTIAL_ENCRYPTION_KEY.
# Gerar com: openssl rand -base64 32
# ---------------------------------------------------------------------------
INBOX_CREDENTIAL_ENCRYPTION_KEY=changeme-run-openssl-rand--base64-32

# ---------------------------------------------------------------------------
# Byte-idêntica entre apps/api e apps/inbox. Gerar com:
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_TOKEN_SIGNING_KEY=changeme-run-openssl-rand--base64-32

# ---------------------------------------------------------------------------
# Operador único de apps/api. Hash gerado offline (ver
# docs/development.md, "Autenticação em desenvolvimento") — nunca em
# texto claro.
# ---------------------------------------------------------------------------
AUTH_OPERATOR_USERNAME=changeme
AUTH_OPERATOR_PASSWORD_HASH=changeme-gerar-offline-ver-docs-development-md

# ---------------------------------------------------------------------------
# Porta interna do host onde o nginx do stack escuta — o nginx
# externo/Cloudflare (fora desta change) faz proxy_pass pra cá. Nunca
# 80/443 diretamente (design.md, D2).
# ---------------------------------------------------------------------------
STACK_HTTP_PORT=8080
